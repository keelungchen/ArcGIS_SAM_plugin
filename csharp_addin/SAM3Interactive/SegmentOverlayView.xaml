<UserControl x:Class="SAM3Interactive.SegmentOverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
  <Border Background="#E01E1E1E" CornerRadius="8" Padding="12,10"
          BorderBrush="#FF4A90D9" BorderThickness="1">
    <StackPanel>
      <TextBlock Text="SAM Interactive Segmentation" FontWeight="Bold"
                 FontSize="14" Foreground="White"/>
      <TextBlock Text="{Binding ModelText}" Foreground="#FF9CC8FF"
                 FontSize="12" Margin="0,2,0,0"/>
      <TextBlock Text="{Binding ClicksText}" Foreground="White"
                 FontSize="12" Margin="0,4,0,0"/>
      <TextBlock Text="{Binding StatusText}" Foreground="#FFFFD080"
                 FontSize="12" TextWrapping="Wrap" MaxWidth="250"
                 Margin="0,4,0,0"/>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <Button Content="✔ Save" Command="{Binding SaveCommand}"
                Focusable="False" Padding="10,3" Margin="0,0,6,0"/>
        <Button Content="↶ Undo" Command="{Binding UndoCommand}"
                Focusable="False" Padding="10,3" Margin="0,0,6,0"/>
        <Button Content="✖ Clear" Command="{Binding ClearCommand}"
                Focusable="False" Padding="10,3" Margin="0,0,6,0"/>
        <Button Content="↺ New Area" Command="{Binding ResetCommand}"
                Focusable="False" Padding="10,3"/>
      </StackPanel>
      <TextBlock Text="Left-click = positive | Right-click = negative"
                 Foreground="#FFBDBDBD" FontSize="11" Margin="0,8,0,0"/>
      <TextBlock Text="Space = save | Ctrl+Z = undo | Esc = clear clicks"
                 Foreground="#FFBDBDBD" FontSize="11"/>
    </StackPanel>
  </Border>
</UserControl>
